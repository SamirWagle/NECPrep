{
  "name": "necprep-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker + D1 API for NECPrep. Schema in migrations/, Drizzle definitions in db/.",
  "scripts": {
    "db:apply:local": "node db/apply.mjs",
    "db:seed:local": "node db/seed/import-questions.mjs",
    "db:reference": "node db/seed/generate-reference-sql.mjs",
    "db:verify": "node db/verify-schema.mjs",
    "db:measure": "node db/measure.mjs",
    "db:check": "npm run db:apply:local && npm run db:seed:local && npm run db:verify && npm run db:smoke && npm run db:typecheck",
    "d1:migrate:local": "wrangler d1 migrations apply necprep --local",
    "d1:migrate:remote": "wrangler d1 migrations apply necprep --remote",
    "db:typecheck": "tsc --noEmit --strict --target es2022 --module nodenext --moduleResolution nodenext --skipLibCheck db/schema.ts",
    "db:smoke": "node db/smoke.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "typescript": "^5.9.0",
    "wrangler": "^4.151.2"
  }
}

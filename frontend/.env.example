# Copy to `.env.local` for local development. `.env.local` is gitignored.
#
# Supabase is gone: this platform runs on Cloudflare Workers + D1. The reasons
# are in docs/adr/0001-cloudflare-d1-over-supabase.md, and the one that matters
# here is that D1 has no row-level security, so there is no anon key to put in
# a browser. The client talks to the Worker and the Worker is the only thing
# that talks to the database.

# Base URL of the NECPrep Worker API, with NO trailing slash.
#
# Leave it UNSET to run fully local: `services/api.ts` then short-circuits every
# call with `BACKEND_NOT_CONFIGURED` and the app serves questions from
# `public/data/*.json` with progress in localStorage. That is a supported mode,
# not a broken one.
#
#   local Worker:  npm run dev  (in ../worker)  ->  http://127.0.0.1:8787
#   deployed:      https://necprep-api.waglesameer5.workers.dev
#
# Vite inlines this at BUILD time, so changing it needs a rebuild, not a
# restart of the server that serves the built files.
VITE_API_BASE_URL=

# NOTE: everything in a VITE_-prefixed variable is PUBLIC. It is compiled into
# the JavaScript every visitor downloads. Never put a secret here. The session
# is an HttpOnly cookie set by the Worker, so the browser never holds a
# credential this file could leak.
